{
    "name": "xphp-lang/xphp",
    "description": "Provides Generics in PHP via Attributes",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "XPHP\\": [
                "src/",
                "test/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XPHP\\Demo\\": [
                "demo/src/",
                "demo/dist/"
            ]
        }
    },
    "authors": [
        {
            "name": "Matheus Martins"
        }
    ],
    "require": {
        "php": "^8.3.0",
        "nikic/php-parser": "^5.1",
        "symfony/console": "^7.1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.26",
        "infection/infection": "^0.29.6"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
