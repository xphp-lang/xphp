<?php

declare(strict_types=1);

namespace App\ClosureArgRun;

final class Book
{
    public function __construct(public string $name) {}
}

class Box<E>
{
    public function __construct(private E $value) {}

    public function map<R>(Closure(E $x): R $fn): R
    {
        return $fn($this->value);
    }
}

$box = new Box::<Book>(new Book('PHP'));
$result = $box->map::<string>(fn(Book $x): string => $x->name);
