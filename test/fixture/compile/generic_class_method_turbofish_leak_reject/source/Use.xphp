<?php

declare(strict_types=1);

namespace App;

// A method turbofish grounded by an enclosing class type parameter: `self::gen::<T>`
// depends on `Box`'s `T`. The class specializes in a phase with no generic-method-call
// rewriting, so `gen` is stripped and the turbofish dropped — the emitted specialization
// calls an undefined `self::gen()`. Rejected before that fatal-able code is emitted.
class Box<T>
{
    public function make(T $v): T
    {
        return self::gen::<T>($v);
    }

    public static function gen<U>(U $x): U
    {
        return $x;
    }
}

$b = new Box::<int>();
$b->make(5);
