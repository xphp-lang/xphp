<?php

declare(strict_types=1);

namespace App\NestedInstantiation\Containers;

class Collection<T>
{
    /** @var array<int, T> */
    public array $items = [];

    public function push(T $val): void
    {
        $this->items[] = $val;
    }

    public function first(): T
    {
        return $this->items[0];
    }
}
