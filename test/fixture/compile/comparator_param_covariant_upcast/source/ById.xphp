<?php

declare(strict_types=1);

namespace App;

// A concrete Comparator<Product>. By contravariance (Comparator<-T>), a Comparator<Product> is also a
// Comparator<Book>, so it can compare the Book elements of a Box<Book> upcast to Box<Product>.
class ById implements Comparator<Product>
{
    public function compare(Product $a, Product $b): int
    {
        return $a->id <=> $b->id;
    }
}
