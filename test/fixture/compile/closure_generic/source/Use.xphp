<?php

declare(strict_types=1);

namespace App\ClosureGeneric;

// Capture-free generic closure -- hoists to a top-level Function_ at
// specialization time. The variable assignment site stays as-is; the call
// site `$pair::<...>(...)` rewrites to the hoisted function call.
$pair = function<K, V>(K $key, V $value): array {
    return [$key, $value];
};

$pair::<string, int>('age', 42);
$pair::<string, int>('count', 7); // same specialization -- de-duped via alreadyGenerated.
