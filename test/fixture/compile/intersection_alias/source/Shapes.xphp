<?php

declare(strict_types=1);

namespace App\Inter;

interface A {}
interface B {}
interface C {}

class AB implements A, B {}
class ABC implements A, B, C {}

// Intersection body as a whole slot (property + param + return), and a DNF body `(A&B)|C`.
type Both = A & B;
type Dnf = (A & B) | C;

class Holder
{
    public Both $both;

    public function __construct(Both $both)
    {
        $this->both = $both;
    }

    public function dnf(Dnf $x): Dnf
    {
        return $x;
    }
}

$holder = new Holder(new AB());
$dnfAB = $holder->dnf(new AB());
$dnfC = $holder->dnf(new ABC());
