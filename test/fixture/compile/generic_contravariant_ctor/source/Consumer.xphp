<?php

declare(strict_types=1);

namespace App\ContraCtor;

// Contravariant constructor param: keeps its real type too. The edge flips —
// `Consumer<Fruit>` extends `Consumer<Banana>` — and the chain still loads
// because PHP exempts `__construct` from LSP.
class Consumer<-T>
{
    private array $items;

    public function __construct(T ...$items)
    {
        $this->items = $items;
    }

    public function accept(T $x): void
    {
        $this->items[] = $x;
    }
}
