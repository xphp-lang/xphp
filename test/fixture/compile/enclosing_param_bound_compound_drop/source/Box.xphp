<?php

declare(strict_types=1);

namespace App;

class Box<+E>
{
    // U must be BOTH `\Stringable` (have a `__toString`) AND a subtype of the element type E. The
    // `\Stringable` half is checkable with no knowledge of E; only the `E` half needs the receiver's
    // element type.
    public function register<U : \Stringable & E>(U $value): void {}
}
