<?php

declare(strict_types=1);

namespace App\QualifiedDefaults;

// A bare `new` of an all-defaults generic synthesizes the defaults tuple.
// The fully-qualified spelling used to be skipped entirely — compile
// emitted `interface Box {}` and kept `new \App\QualifiedDefaults\Box(...)`,
// a guaranteed runtime fatal behind a clean gate.

class Box<T = string>
{
    public function __construct(public T $v)
    {
    }
}

$a = new \App\QualifiedDefaults\Box("hi");
