<?php

declare(strict_types=1);

namespace App\ClosureArgStaticRun;

// A generic static method on a non-generic class — the clean runnable static-turbofish
// shape (a static generic method on a *generic* class is a separate emission limitation).
class Util
{
    public static function apply<R>(Closure(R $x): R $fn, R $seed): R
    {
        return $fn($seed);
    }
}

$result = Util::apply::<int>(fn(int $x): int => $x + 40, 2); // 2 + 40 = 42
