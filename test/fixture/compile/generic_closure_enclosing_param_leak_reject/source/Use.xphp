<?php

declare(strict_types=1);

namespace App;

// A generic closure grounded only by an enclosing function type parameter: the
// `$inner::<S>` turbofish depends on `relay`'s `S`, which is not concrete here, so
// the dispatch cannot be materialized. Left un-grounded it would emit `fn(I $x): I`
// referencing the non-existent class `App\I` — a runtime TypeError. Rejected instead.
function relay<S>(S $v): S
{
    $inner = fn<I>(I $x): I => $x;
    return $inner::<S>($v);
}

relay::<int>(3);
