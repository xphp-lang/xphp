<?php

declare(strict_types=1);

namespace App\Bucket3Reject;

final class Book
{
    public function __construct(public string $name) {}
}

class Box<E>
{
    public function __construct(private E $v) {}

    public function each(Closure(E $x): string $fn): string
    {
        return $fn($this->v);
    }

    public function describe(): string
    {
        // Under Box<Book>, `each` grounds to Closure(Book): string; `fn(int)` is a
        // provable contravariance violation that must fail the compile.
        return $this->each(fn(int $x): string => 'z');
    }
}

$b = new Box::<Book>(new Book('x'));
$b->describe();
