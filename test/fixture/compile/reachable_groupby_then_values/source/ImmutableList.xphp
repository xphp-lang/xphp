<?php

declare(strict_types=1);

namespace App;

class ImmutableList<+E> extends AbstractImmutableCollection<E> implements OrderedCollection<E>
{
    public function get(int $i): E
    {
        return $this->items[$i];
    }

    public function first(): ?E
    {
        return $this->items[0] ?? null;
    }

    // The real list->map derivation. A generic method (call-site-driven via turbofish); its body builds
    // a map of sub-lists. The return type re-wraps the receiver's family, so eager discovery towered.
    public function groupBy<L>(callable $keyOf): ImmutableMap<L, ImmutableList<E>>
    {
        $buckets = [];
        foreach ($this->items as $item) {
            $buckets[$keyOf($item)][] = $item;
        }

        $grouped = [];
        foreach ($buckets as $key => $items) {
            $grouped[$key] = new ImmutableList::<E>(...$items);
        }

        return new ImmutableMap::<L, ImmutableList<E>>($grouped);
    }
}
