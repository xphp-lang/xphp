<?php

declare(strict_types=1);

namespace App;

// Group a covariant ImmutableList into an ImmutableMap of sub-lists, then iterate the groups through the
// map's covariant `values()` view (OrderedCollection<ImmutableList<Item>>) — the natural thing to do
// after grouping. Reaching the view re-exposes a list-of-lists, and the call-site-driven groupBy body
// (which constructs `new ImmutableMap::<L, ImmutableList<E>>(...)`) rides onto the nested-list spec,
// re-seeding the `List -> Map -> List -> ...` tower.
$list  = new ImmutableList::<Item>(new Item(1, 'a'), new Item(2, 'a'), new Item(3, 'b'));
$map   = $list->groupBy::<string>(fn (Item $i): string => $i->group);
$groups = $map->values();
$first  = $groups->first();
$n      = $first?->count();
