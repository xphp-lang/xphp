<?php

declare(strict_types=1);

namespace App;

abstract class AbstractImmutableCollection<+E> implements Collection<E>
{
    /** @var list<E> */
    protected array $items;

    public function __construct(E ...$items)
    {
        $this->items = $items;
    }

    public function count(): int
    {
        return \count($this->items);
    }
}
