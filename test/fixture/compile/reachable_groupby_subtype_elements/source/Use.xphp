<?php

declare(strict_types=1);

namespace App;

// Group at two element types that are subtype-related (Book <: Media). The two resulting maps are
// therefore variance-related — `ImmutableMap<string, ImmutableList<Book>> <: ImmutableMap<string,
// ImmutableList<Media>>` — so a covariant override edge should form on `Map::get()`. Under single
// inheritance that covariant leaf edge is dropped (ImmutableMap already has a real source parent), so
// the build is clean but the generated `get()` overrides are incompatible at PHP class-load time.
$books = new ImmutableList::<Book>(new Book(1, 'b'), new Book(2, 'b'));
$media = new ImmutableList::<Media>(new Media(3, 'm'));

$byKind  = $books->groupBy::<string>(fn (Media $m): string => $m->kind);
$byKind2 = $media->groupBy::<string>(fn (Media $m): string => $m->kind);

$one = $byKind->get('b');
$two = $byKind2->get('m');
$n   = ($one?->count() ?? 0) + ($two?->count() ?? 0);
