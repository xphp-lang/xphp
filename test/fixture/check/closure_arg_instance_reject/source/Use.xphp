<?php

declare(strict_types=1);

namespace App\ClosureArgCheck;

final class Book
{
    public function __construct(public string $name) {}
}

// A higher-order method whose closure parameter references the class parameter E
// and the method parameter R. At a grounded call site the target becomes concrete.
class Box<E>
{
    public function __construct(private E $value) {}

    public function map<R>(Closure(E $x): R $fn): R
    {
        return $fn($this->value);
    }
}

function run(): void
{
    $box = new Box::<Book>(new Book('PHP'));
    // Target grounds to Closure(Book $x): string. The literal takes `int` — a
    // provable contravariance violation (int is not wider than Book).
    $box->map::<string>(fn(int $x): string => (string) $x);
}
