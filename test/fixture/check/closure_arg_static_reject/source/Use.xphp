<?php

declare(strict_types=1);

namespace App\ClosureArgStatic;

class Util<E>
{
    // R is a method type parameter (grounded by the call's turbofish); E is a class
    // parameter, unbound in a static context.
    public static function apply<R>(Closure(R $x): R $fn, R $seed): R
    {
        return $fn($seed);
    }
}

function run(): void
{
    // Target grounds to Closure(int $x): int. The literal takes `string` — a provable
    // contravariance violation (string is not wider than int).
    Util::apply::<int>(fn(string $x): int => 0, 5);
}
