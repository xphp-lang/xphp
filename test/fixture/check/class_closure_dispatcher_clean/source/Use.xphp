<?php

declare(strict_types=1);

namespace App;

// A CONCRETE variable turbofish inside a generic CLASS method: compile materializes
// the closure dispatcher and the program runs. Check never materializes dispatchers,
// so the spec clone legitimately still carries the `$f::<int>` marker — the grounding
// pass's backstop must not flag it (that would reject code compile accepts).
final class Box<T>
{
    public function m(T $seed): int
    {
        $f = fn<U>(U $x): U => $x;
        return $f::<int>(41);
    }
}

$b = new Box::<int>();
$b->m(1);
