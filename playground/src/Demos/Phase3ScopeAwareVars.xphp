<?php

declare(strict_types=1);

namespace App\Demos;

// Phase 3 fixture: scope-aware variable completion.
//
// Trigger completion at each `// CURSOR HERE -> $` marker below by
// typing `$` and Ctrl+Space.  Expected sets:
//
//   1. Top-level cursor: only top-level vars (`$topLevel`, `$factor`,
//      `$result`, ...).  Function locals must NOT leak in.
//
//   2. Inside `regularFn`: only that function's params + locals
//      (`$param`, `$localFn`).  Top-level `$topLevel`/`$factor` are
//      HIDDEN because regular functions are scope barriers.
//
//   3. Inside the closure: `$capturedFactor` (via `use`) + closure's
//      params + locals.  `$topLevel`/`$result` are HIDDEN because
//      closures only see what `use (...)` brings in.
//
//   4. Inside the arrow fn: `$factor` IS visible (arrow fns auto-
//      capture by value).  `$topLevel` too -- all outer-scope vars
//      auto-flow.

$topLevel = 1;
$factor = 2;
$result = $topLevel * $factor;

// CURSOR HERE (1) -- top-level scope.  Should see $topLevel, $factor,
// $result, but NOT $param/$localFn/$capturedFactor/$inner/$arrowArg.
echo $result;

function regularFn(int $param): int
{
    $localFn = $param * 2;
    // CURSOR HERE (2) -- inside regularFn.  Should see $param, $localFn.
    // Must NOT see $topLevel, $factor, $result.
    return $localFn;
}

$cb = function (int $closureParam) use ($factor) {
    $capturedFactor = $factor;
    $inner = $closureParam + $capturedFactor;
    // CURSOR HERE (3) -- inside closure body.  Should see $closureParam,
    // $factor (via use), $capturedFactor, $inner.  Must NOT see $topLevel.
    return $inner;
};

$arrowCb = fn (int $arrowArg) => $arrowArg * $factor + $topLevel;
//                                           // CURSOR HERE (4) -- inside
// arrow fn body.  Arrow fns auto-capture: $arrowArg + $factor + $topLevel
// all visible.
