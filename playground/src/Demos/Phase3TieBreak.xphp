<?php

declare(strict_types=1);

namespace App\Demos;

// Phase 3 fixture: short-name tie-break in findClassByName.
//
// The lookup runs on the SHORT name when GTD lands in a type-arg
// position WITHOUT a `use` statement.  `User` could resolve to:
//   - `App\Models\User`         (canonical, playground/src/Models/User.xphp)
//   - `App\TestFixtures\User`   (fixture,   playground/tests/Fixtures/User.xphp)
//
// Phase 3 ranks by URI penalty: vendor/tests/fixtures paths get +10
// each, so the canonical src/ copy wins.
//
// Test:
//   1. Open BOTH playground/src/Models/User.xphp AND
//      playground/tests/Fixtures/User.xphp in the editor.
//   2. Ctrl+Click `User` in the type-arg below.
//   3. The jump should land in src/Models/User.xphp (canonical), NOT
//      in tests/Fixtures/User.xphp.

function identity<T>(T $x): T { return $x; }

$u = identity<User>(null);

echo $u?->name ?? 'nothing';
