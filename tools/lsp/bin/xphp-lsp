#!/usr/bin/env php
<?php

declare(strict_types=1);

// Entry point for the xphp Language Server. Speaks LSP over stdio so any
// LSP-aware client (VS Code via the bundled extension, Neovim, Helix, etc.)
// can drive it without a transport-specific shim.
//
// The actual server boot lives in XPHP\Lsp\Server::run() — this script is
// just the thinnest possible CLI veneer plus autoloader resolution.

// Silence E_DEPRECATED at the entry-point. phpactor/language-server pulls in
// thecodingmachine/safe, which currently emits many implicit-nullable deprecation
// notices under PHP 8.4 at autoload time. Without this, the deprecation chatter
// drowns the analyzer's actual output (an LSP client sees this on stderr too).
//
// CAVEAT: this suppression is intentionally broad — it ALSO masks deprecations
// we ourselves might introduce in xphp source under tools/lsp/. The PHPUnit
// surface has a finer-grained equivalent (`<source ignoreIndirectDeprecations
// ="true">` in phpunit.xml.dist) that distinguishes by source path, but the
// runtime PHP API doesn't expose anything equivalent. If we ever start
// emitting deprecations in our own code, revisit this — the easy mitigation
// is to drop the suppression and instead pin phpactor / thecodingmachine/safe
// to versions that have caught up with PHP 8.4.
error_reporting(E_ALL & ~E_DEPRECATED);

$autoload = null;
foreach ([
    __DIR__ . '/../vendor/autoload.php',          // standalone install (composer install in tools/lsp/)
    __DIR__ . '/../../../vendor/autoload.php',    // installed as a dep of the root xphp package
] as $candidate) {
    if (is_file($candidate)) {
        $autoload = $candidate;
        break;
    }
}

if ($autoload === null) {
    fwrite(STDERR, "xphp-lsp: could not locate vendor/autoload.php — run `composer install` inside tools/lsp/.\n");
    exit(1);
}

require $autoload;

exit(XPHP\Lsp\Server::run($argv));
