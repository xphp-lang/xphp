{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "xphp",
  "scopeName": "source.xphp",
  "patterns": [
    {
      "include": "#xphp-extras"
    },
    {
      "include": "source.php"
    }
  ],
  "repository": {
    "xphp-extras": {
      "patterns": [
        {
          "comment": "Generic argument clause after a class-like name: `Box<...>`. Highlights the angle brackets as operators so they stand out from the bundled PHP grammar that would otherwise miss them.",
          "name": "meta.generic.xphp",
          "begin": "(?<=[A-Za-z_\\\\][A-Za-z0-9_\\\\]*)\\s*(<)(?=[A-Za-z_\\\\\\s])",
          "end": "(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.generic.begin.xphp" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.generic.end.xphp" }
          },
          "patterns": [
            {
              "name": "entity.name.type.xphp",
              "match": "[A-Za-z_\\\\][A-Za-z0-9_\\\\]*"
            },
            {
              "name": "punctuation.separator.generic.xphp",
              "match": ","
            },
            {
              "name": "punctuation.separator.bound.xphp",
              "match": ":"
            }
          ]
        }
      ]
    }
  }
}
