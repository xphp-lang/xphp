# Gradle artifacts.
.gradle/
build/

# IntelliJ Platform Gradle Plugin local artifact cache + plugin sandbox --
# generated by `prepareSandbox` / `prepareTestSandbox` and the IDE-installer
# resolution machinery.  Regenerated on demand by `./gradlew build`.
.intellijPlatform/

# IDE workspace.
.idea/
*.iml

# Generated resources -- chunk 3 onward copies tmLanguage.json + chunk 5 copies
# the xphp-lsp PHAR into src/main/resources/ at build time.  Source of truth
# is tools/lsp/, not a checked-in duplicate here.
src/main/resources/textmate/xphp.tmLanguage.json
src/main/resources/bin/xphp-lsp.phar
