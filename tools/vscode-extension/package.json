{
  "name": "xphp-language",
  "displayName": "xphp Language",
  "description": "Language support for xphp: diagnostics, hover, go-to-definition, and completion for .xphp files via the xphp-lsp server.",
  "version": "0.1.0",
  "publisher": "xphp-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xphp-lang/xphp.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:xphp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "xphp",
        "aliases": [
          "xphp",
          "XPHP"
        ],
        "extensions": [
          ".xphp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xphp",
        "scopeName": "source.xphp",
        "path": "./syntaxes/xphp.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "xphp",
      "properties": {
        "xphp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the xphp-lsp binary. If empty, defaults to <workspace>/tools/lsp/bin/xphp-lsp."
        },
        "xphp.phpPath": {
          "type": "string",
          "default": "php",
          "description": "PHP binary used to run xphp-lsp. Override if your PHP isn't on PATH or you need a specific version."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
